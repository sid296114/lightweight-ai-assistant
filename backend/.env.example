# 复制为 .env 并填写实际值
APP_NAME=轻量AI助手
APP_VERSION=1.0.0
DEBUG=false

# 数据库（MySQL 8.0）
DATABASE_URL=mysql+pymysql://<user>:<password>@127.0.0.1:3306/ai_assistant?charset=utf8mb4

# JWT 鉴权（务必替换为随机字符串）
JWT_SECRET=<random-secret>
JWT_EXPIRE_DAYS=7

LOGIN_FAIL_LIMIT=5
LOGIN_FAIL_WINDOW_SECONDS=600

# 大模型 API（OpenAI 兼容接口）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
MOCK_LLM=true

FILE_MAX_MB=10
FILE_MAX_PAGES=50
FILE_MAX_CHARS=200000

# AI 绘图（选型待定，预留）
DRAW_API_KEY=
DRAW_BASE_URL=
DRAW_MODEL=
